#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly ruby_version="4.0.6"
readonly ruby_archive="ruby-${ruby_version}.x86_64_linux.tar.gz"
readonly ruby_url="https://github.com/jdx/ruby/releases/download/${ruby_version}/${ruby_archive}"
readonly ruby_sha256="aefa111873bac3b15c5c416bfaaca84e793d5312d4496d651ad79c44521b200a"

cd "$repo_root"

echo "Installing database services..."
sudo apt-get update || true
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
  postgresql \
  postgresql-contrib \
  redis-server

echo "Starting database services..."
sudo service postgresql start
sudo service redis-server start

sudo -u postgres createuser --superuser "$(id -un)" 2>/dev/null || true

echo "Installing Ruby and gems..."
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

curl --fail --location --silent --show-error "$ruby_url" --output "$tmp_dir/$ruby_archive"
printf '%s  %s\n' "$ruby_sha256" "$tmp_dir/$ruby_archive" | sha256sum --check

mkdir -p "$HOME/.local"
tar --extract --gzip \
  --file "$tmp_dir/$ruby_archive" \
  --directory "$HOME/.local" \
  --strip-components 1

gem install bundler-audit --no-document
bundle install --jobs "$(nproc)"

echo "Preparing Rails databases..."
bin/rails db:prepare

echo "Cloud sandbox setup complete."
